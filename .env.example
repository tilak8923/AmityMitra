# Copy to .env and fill in. NEVER commit the real .env.
# (These are read on first boot; after that, config.json / the admin panel win.)

# Admin panel password (choose a strong one)
ADMIN_PASSWORD=change-me

# Telegram bot — from @BotFather
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=YourAmizonBot

# Server port
PORT=8787
